---


{cetificates.map(({ title, description, link, image }) => (
        <article class="w-full md:max-w-[350px] lg:max-w-[380px] p-2 mb-4 rounded-xl flex flex-col justify-between art_card">
            <div class="flex flex-col gap-2">
                <h3 class="text-lg font-semibold">{title}</h3>
                {/* <p class="text-sm text-pretty text_info">
                    {description.split(" ").slice(0, 15).join(" ")}{description.split(" ").length > 15 ? "..." : ""}
                </p> */}
                <embed src={link} type="application/pdf" class="w-full h-full min-h-60 overflow-hidden" />
                <a href={link} target="_blank" rel="noopener noreferrer" class="text-sm text-[var(--color-m)] hover:underline emphasis_text">Ver certificado</a>
            </div>
    </article>
    ))}
